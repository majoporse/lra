<?xml version="1.0" encoding="UTF-8"?>
<module name="org.jboss.narayana.lra.lra-coordinator" xmlns="urn:jboss:module:1.9">
  <properties>
    <property name="jboss.api" value="private"/>
  </properties>
  <resources>
    <resource-root path="lra-coordinator-jar-${project.version}.jar"/>
    <resource-root path="lra-coordinator-core-${project.version}.jar"/>
    <resource-root path="lra-connector-common-contracts-${project.version}.jar"/>
    <resource-root path="lra-connector-common-coordinator-${project.version}.jar"/>
    <resource-root path="lra-connector-http-contracts-${project.version}.jar"/>
    <resource-root path="lra-connector-http-coordinator-${project.version}.jar"/>
  </resources>
  <dependencies>
    <module name="org.eclipse.microprofile.lra.api"/>
    <module name="jakarta.ws.rs.api"/>
    <module name="org.jboss.logging"/>
    <module name="org.jboss.narayana.lra.lra-service-base"/>
    <module name="io.smallrye.jandex"/>
    <module name="org.jboss.modules"/>

    <module name="com.fasterxml.jackson.core.jackson-core"/>
    <module name="com.fasterxml.jackson.core.jackson-databind"/>
    <module name="org.jboss.jts"/>
    <module name="org.eclipse.microprofile.config.api"/>
    <module name="jakarta.enterprise.api"/>
    <module name="jakarta.servlet.api"/>
    <module name="org.eclipse.microprofile.openapi.api"/>
    <module name="io.smallrye.fault-tolerance"/>
    <module name="io.smallrye.config" optional="true"/>

    <!-- BearerTokenResolver / JWT callback token propagation -->
    <module name="org.eclipse.microprofile.jwt" optional="true"/>

    <!-- JAX-RS client dependencies for HTTP callback deliveries and recovery -->
    <module name="org.jboss.resteasy.resteasy-jaxrs" services="export"/>
    <module name="org.jboss.resteasy.resteasy-jaxb-provider" services="export"/>
    <module name="org.jboss.resteasy.resteasy-jackson2-provider" services="export"/>
  </dependencies>
</module>
